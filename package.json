{
  "name": "crm-react-apps-webpack",
  "version": "1.0.0",
  "description": "Multi-app React monorepo with Webpack, shared packages, and PCF components for Dynamics 365",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared",
    "pcf/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:transcript-and-summary": "npm run dev --workspace=apps/transcript-and-summary",
    "dev:if-party-master": "npm run dev --workspace=apps/if-party-master",
    "dev:shell": "npm run dev --workspace=apps/shell",
    "dev:all:microfrontend": "concurrently \"npm run dev:microfrontend --workspace=apps/transcript-and-summary\" \"npm run dev:microfrontend --workspace=apps/if-party-master\" \"npm run dev:microfrontend --workspace=apps/shell\"",
    "dev:all": "concurrently \"npm run dev:transcript-and-summary\" \"npm run dev:if-party-master\" \"npm run dev:shell\"",
    "build:transcript-and-summary": "npm run build --workspace=apps/transcript-and-summary",
    "build:if-party-master": "npm run build --workspace=apps/if-party-master",
    "build:shell": "npm run build --workspace=apps/shell",
    "build:transcript-and-summary:webresource": "npm run build:webresource --workspace=apps/transcript-and-summary",
    "build:transcript-and-summary:standalone": "npm run build --workspace=apps/transcript-and-summary",
    "build:transcript-and-summary:microfrontend": "cross-env WEBPACK_DEPLOYMENT_MODE=microfrontend npm run build --workspace=apps/transcript-and-summary",
    "build:if-party-master:webresource": "npm run build:webresource --workspace=apps/if-party-master",
    "build:if-party-master:standalone": "npm run build --workspace=apps/if-party-master",
    "build:if-party-master:microfrontend": "cross-env WEBPACK_DEPLOYMENT_MODE=microfrontend npm run build --workspace=apps/if-party-master",
    "build:shell:standalone": "npm run build --workspace=apps/shell",
    "build:shell:microfrontend": "cross-env WEBPACK_DEPLOYMENT_MODE=microfrontend npm run build --workspace=apps/shell",
    "build:shared": "npm run build --workspace=shared",
    "build:shared:webresource": "npm run build:webresource --workspace=shared",
    "build:shared:standalone": "npm run build:standalone --workspace=shared",
    "build:pcf": "npm run build --workspace=pcf/contact-timeline-control",
    "build:all": "npm run build:shared && npm run build:transcript-and-summary && npm run build:if-party-master && npm run build:shell",
    "build:all:webresource": "npm run build:transcript-and-summary:webresource && npm run build:if-party-master:webresource",
    "build:standalone": "npm run build:all",
    "build:microfrontend": "cross-env WEBPACK_DEPLOYMENT_MODE=microfrontend npm run build:all",
    "build:webresource": "npm run build:all:webresource",
    "preview:transcript-and-summary": "npm run preview --workspace=apps/transcript-and-summary",
    "preview:if-party-master": "npm run preview --workspace=apps/if-party-master",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit --strict",
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .ts,.tsx --ignore-path .gitignore --fix",
    "lint:check": "eslint . --ext .ts,.tsx --ignore-path .gitignore --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "npm run type-check && npm run lint:check && npm run format:check",
    "quality:fix": "npm run format && npm run lint:fix",
    "clean": "rimraf \"apps/*/dist\" \"shared/dist\" \"pcf/*/dist\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:watch": "jest --coverage --watch",
    "test:coverage:threshold": "jest --coverage --coverageThreshold",
    "test:shared": "jest --selectProjects shared",
    "test:shared:coverage": "jest --selectProjects shared --coverage",
    "test:transcript-and-summary": "jest --selectProjects transcript-and-summary",
    "test:if-party-master": "jest --selectProjects if-party-master",
    "test:simple": "jest shared/__tests__/simple.test.tsx",
    "test:theme": "jest shared/__tests__/theme.test.tsx",
    "test:components": "jest shared/__tests__/components.test.tsx",
    "test:utils": "jest shared/__tests__/utils.test.ts",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@module-federation/enhanced": "^0.6.9",
    "@module-federation/runtime": "^0.18.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "mini-css-extract-plugin": "^2.7.6",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/crm-react-apps-webpack.git"
  },
  "keywords": [
    "react",
    "webpack",
    "monorepo",
    "typescript",
    "dynamics365",
    "pcf",
    "module-federation"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "dependencies": {
    "@module-federation/runtime": "^0.18.0"
  }
}
